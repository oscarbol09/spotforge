# SpotForge Configuration (v2)
# Google Gemini / Gemma API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (Get at https://elevenlabs.io/)
# NOTE: Free plan is for testing/development. Commercial resale requires Starter ($6/mo) or above.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# LLM Backend: 'gemini' (default, cloud Gemma 4) or 'ollama' (local inference)
LLM_BACKEND=gemini
OLLAMA_BASE_URL=http://localhost:11434

# Gemma open-weight models: gemma-4-26b-a4b-it, gemma-4-31b-it
GEMMA_MODEL_ID=gemma-4-26b-a4b-it
FALLBACK_MODEL_ID=gemma-4-31b-it

# ElevenLabs Model: eleven_multilingual_v2 (recommended), eleven_v4, eleven_flash_v2_5
ELEVENLABS_MODEL=eleven_multilingual_v2

# Default Voice Settings (Obtain IDs dynamically via /api/voices)
DEFAULT_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
DEFAULT_LANGUAGE=es

# Server & Storage Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
AUDIO_TTL_HOURS=24
ENABLE_MUSIC_MIXING=true

# Public Demo Rate Limiting (Protects API quotas on public deployments)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=300

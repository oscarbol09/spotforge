# SpotForge Configuration
# Google Gemini / Gemma API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (Get at https://elevenlabs.io/)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Model Configuration
# Gemma open-weight models: gemma-3-27b-it, gemma-3-12b-it, gemma-3-4b-it, gemma-2-9b-it
GEMMA_MODEL_ID=gemma-3-27b-it

# Default Voice Settings (Rachel: JBFqnCBsd6RMkjVDRZzb, Adam: pNInz6obpgDQGcFmaJgB)
DEFAULT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
DEFAULT_LANGUAGE=es

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
